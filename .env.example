# -------- Gemini backend --------
# Option A: Gemini Developer API (simplest)
#GOOGLE_API_KEY=your-api-key-from-ai-studio
#NCERT_USE_VERTEXAI=false

# Option B: Vertex AI (comment out GOOGLE_API_KEY above, use these instead)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
NCERT_USE_VERTEXAI=true
# (also run: gcloud auth application-default login)

# -------- Models --------
NCERT_CAPTION_MODEL=gemini-2.5-flash
NCERT_CHAT_MODEL=gemini-2.5-flash
NCERT_EMBEDDING_MODEL=models/text-embedding-004

# -------- Data root --------
NCERT_DATA_ROOT=./data/standard

# -------- Retrieval / generation --------
NCERT_RETRIEVER_K=8
NCERT_CHAT_TEMPERATURE=0.2

# -------- Reranking (the Contextual Relevancy fix; opt-in) --------
# Turn on after: pip install -e ".[rerank]"
NCERT_USE_RERANKER=false
NCERT_RERANK_FETCH_K=20
# NCERT_RERANKER_MODEL=BAAI/bge-reranker-base

# Alternative/simpler lever if you don't want the reranker (0 = off):
NCERT_RETRIEVER_SCORE_THRESHOLD=0.0

# -------- Chunking (smaller = better relevancy) --------
NCERT_MAX_CHUNK_CHARS=700
NCERT_CHUNK_OVERLAP=100

# -------- Extraction thresholds (rarely need changing) --------
NCERT_DECORATIVE_MIN_DIM=2000
NCERT_DECORATIVE_MAX_BYTES=12000
NCERT_MIN_CONTENT_BYTES=8000
NCERT_OCR_MIN_CONFIDENCE=60
NCERT_OCR_MIN_CHARS=8
NCERT_VECTOR_FIG_MIN_AREA_FRAC=0.02
NCERT_VECTOR_FIG_MAX_AREA_FRAC=0.85
NCERT_VECTOR_FIG_DPI=150